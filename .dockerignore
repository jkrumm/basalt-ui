# Build context is the repo ROOT, not apps/marketing
# (.github/workflows/deploy.yml: dockerfile: apps/marketing/Dockerfile, context: ".").
#
# apps/marketing/Dockerfile COPYs: package.json, bun.lock, tsconfig.json,
# apps/{marketing,playground}/package.json, packages/basalt-ui/package.json and
# the apps/marketing tree. Every pattern below is either untracked-and-generated
# or provably unreferenced by those COPYs.

# Dependencies (reinstalled in the builder stage)
**/node_modules

# Build output — apps/marketing/dist is produced *inside* the image by
# `bun run build`; a stale local copy must not be shipped in.
**/dist
**/build
**/.output
**/*.tsbuildinfo
**/*.tgz

# Astro's generated type cache — regenerated by `astro check`; gitignored, so CI
# builds already run without it.
**/.astro

# VCS — nothing reads git metadata at build time (starlight `lastUpdated` is off)
.git
.gitignore

# Secrets / local env
.env
.env.*

# CI + tooling config, not part of the image
.github
.claude
.vscode
.idea

# Noise
**/.DS_Store
**/*.log
coverage
.nyc_output
.turbo
.cache
sc-note.md
