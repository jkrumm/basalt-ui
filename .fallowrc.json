{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/basalt-ui/test/**",
    "packages/basalt-ui/tests/**",
    "packages/basalt-ui/scripts/**",
    "packages/basalt-ui/src/**/*.type-guard.{ts,tsx}",
    "packages/basalt-ui/src/**/*.type-test.ts",
    "packages/basalt-ui/src/css/templates/**",
    "packages/basalt-ui/src/tokens/golden/**",
    "packages/basalt-ui/src/lint/factory.oxlint.mjs",
    "scripts/**",
    "tests/setup/**",
    "tools/**",
    "apps/playground-astro/scripts/**",
    "apps/playground-astro/src/parts/**",
    "apps/playground-astro/src/lib/probe.ts",
    "apps/playground/src/cycle/*/known.ts",
    "apps/expression/src/cycle/*/known.ts",
    "apps/playground/src/recipes/**",
    "apps/playground/src/**/*.type-guard.ts"
  ],
  "ignorePatterns": ["examples/**", "**/test/fixtures/**", "**/tests/fixtures/**"],
  "ignoreExports": [
    {
      "file": "tools/spikes/f2-route/stubs/*.ts",
      "exports": ["*"]
    },
    {
      "file": "packages/basalt-ui/tests/quality/ssr/fixtures/*.tsx",
      "exports": ["Page"]
    },
    {
      "file": "apps/playground/src/routes/settings.tsx",
      "exports": ["SettingsPage"]
    },
    {
      "file": "apps/playground/src/recipes/remembered-values.ts",
      "exports": ["DEFAULT_WINDOW", "useRememberWindow"]
    },
    {
      "file": "apps/playground/src/recipes/websocket-transport.ts",
      "exports": ["changes"]
    },
    {
      "file": "scripts/evidence/*.ts",
      "exports": ["bundle", "keyboard", "screens"]
    },
    {
      "file": "apps/marketing/src/lib/{utils,chartUtils}.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/marketing/src/components/ui/card.tsx",
      "exports": ["*"]
    }
  ]
}
