# Generated files — owned by their generator, not by oxfmt.
# semantic-release rewrites CHANGELOG.md on every release; formatting it here
# means the formatter and the generator fight, and the gate goes red on every
# release commit (which carries [skip ci], so it surfaces on the next PR instead).
**/CHANGELOG.md

# The golden palette fixture is a byte-for-byte snapshot of `buildPaletteCss()`
# output (tests/palette-css.test.ts). Formatting it rewrites the very bytes it
# exists to pin — the test would then fail against the emitter it just proved
# correct. Regenerated by tests/fixtures/regen.ts, never by hand or by oxfmt.
packages/basalt-ui/tests/fixtures/palette-default.css

# tokens.css is `emitTokensCss` output byte for byte (src/css/generate.test.ts pins committed ==
# generated); oxfmt would wrap its long shadow and font lines and break that equality.
packages/basalt-ui/src/css/tokens.css
# tailwind.css is the same generator's output under the same pin; the `--basalt-*` names put its
# `color-mix` lines past the print width.
packages/basalt-ui/src/css/tailwind.css
# static.css is tailwind.css with other imports, from the same generator under the same pin.
packages/basalt-ui/src/css/static.css

# Package fixture trees are byte-exact (deliberate offenders, golden files); never formatted.
packages/basalt-ui/test/fixtures/**

# Golden emit sheets are byte-exact (src/tokens/emit-fallback.test.ts); oxfmt would rewrite the pinned bytes.
packages/basalt-ui/src/tokens/golden/**

# The shipped stylelint preset is `renderStylelintConfig()` output byte for byte (src/lint/stylelint/stylelint.test.ts
# pins committed == rendered), the same bytes a consumer's `sync` writes; oxfmt would re-wrap its arrays.
packages/basalt-ui/configs/stylelint.basalt.json

# A generated doc is `gen-docs` / `gen-ui` output byte for byte: its signature block, its long `peers:` and
# `slots:` lines and the `@example` code of its JSDoc are all text oxfmt would rewrite, which `--check` then
# reads as drift. The hand-written guides stay formatted.
packages/basalt-ui/docs/*.md
!packages/basalt-ui/docs/cartesian-chart-guide.md
!packages/basalt-ui/docs/motion.md
!packages/basalt-ui/docs/eject.md
!packages/basalt-ui/docs/persisted.md
!packages/basalt-ui/docs/static-site.md
!packages/basalt-ui/docs/testing.md
!packages/basalt-ui/docs/vite.md
!packages/basalt-ui/docs/widgets.md

# The Astro matrix record: scripts/matrix.ts --update writes the JSON one part per line and renders the
# .md from it; `make astro-matrix` fails when the .md is not that rendering, so a formatter pass would fail it.
docs/v3/verdicts/astro-matrix.json
docs/v3/verdicts/astro-matrix.md

# The playground's `basalt-ui init` token outputs: doctor check 10 holds them byte for byte to `tokens:css`.
apps/playground/src/tokens.css
apps/playground/src/basalt.tokens.css.d.ts
apps/expression/src/tokens.css
apps/expression/src/basalt.tokens.css.d.ts

# CONTRACT.md holds blocks written by packages/basalt-ui/scripts/gen-contract.ts; gen-contract.test.ts
# pins them byte for byte, so oxfmt must not re-pad their tables.
docs/v3/CONTRACT.md

# The dashboard's committed data snapshot, written compact by apps/playground/scripts/cbbi-snapshot.ts;
# formatting it would spread two thousand readings per series over as many lines.
apps/playground/src/demo/cbbi.snapshot.json
