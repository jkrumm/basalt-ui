# Generated files — owned by their generator, not by oxfmt.
# semantic-release rewrites CHANGELOG.md on every release; formatting it here
# means the formatter and the generator fight, and the gate goes red on every
# release commit (which carries [skip ci], so it surfaces on the next PR instead).
**/CHANGELOG.md

# The golden palette fixture is a byte-for-byte snapshot of `buildPaletteCss()`
# output (tests/palette-css.test.ts). Formatting it rewrites the very bytes it
# exists to pin — the test would then fail against the emitter it just proved
# correct. Regenerated by tests/fixtures/regen.ts, never by hand or by oxfmt.
packages/basalt-ui/tests/fixtures/palette-default.css

# tokens.css is `emitTokensCss` output byte for byte (src/css/generate.test.ts pins committed ==
# generated); oxfmt would wrap its long shadow and font lines and break that equality.
packages/basalt-ui/src/css/tokens.css

# A generated root-export doc carries the root's long `peers:` line; oxfmt wraps it and gen-docs
# --check then reads the file as drifted. Owned by `gen-docs`, never by oxfmt.
packages/basalt-ui/docs/external-field.md
packages/basalt-ui/docs/create-format.md
packages/basalt-ui/docs/use-format.md
packages/basalt-ui/docs/code-block.md
packages/basalt-ui/docs/notify.md

# Package fixture trees are byte-exact (deliberate offenders, golden files); never formatted.
packages/basalt-ui/test/fixtures/**

# Golden emit sheets are byte-exact (src/tokens/emit-fallback.test.ts); oxfmt would rewrite the pinned bytes.
packages/basalt-ui/src/tokens/golden/**

# Generated ui docs whose `slots:` line is wider than the print width; oxfmt wraps it and gen-ui
# --check then reads the file as drifted. Owned by `gen-ui`, never by oxfmt.
packages/basalt-ui/docs/dialog.md
packages/basalt-ui/docs/select.md
packages/basalt-ui/docs/combobox.md
packages/basalt-ui/docs/menu.md

# The shipped stylelint preset is `renderStylelintConfig()` output byte for byte (src/lint/stylelint/stylelint.test.ts
# pins committed == rendered), the same bytes a consumer's `sync` writes; oxfmt would re-wrap its arrays.
packages/basalt-ui/configs/stylelint.basalt.json

# Generated from renderStylelintConfig's JSDoc; owned by `gen-docs`, never by oxfmt.
packages/basalt-ui/docs/render-stylelint-config.md
