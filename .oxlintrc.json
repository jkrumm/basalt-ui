{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "unicorn", "jsx-a11y", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-var": "error",
    "eqeqeq": "error",
    "no-console": "warn",
    "no-shadow": "off",
    "react/globals": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/preserve-manual-memoization": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "no-constant-binary-expression": "error",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "import/no-default-export": "error",
    "import/consistent-type-specifier-style": "error",
    "react/hook-use-state": "warn",
    "react/no-unstable-nested-components": [
      "warn",
      {
        "allowAsProps": true
      }
    ]
  },
  "ignorePatterns": [
    ".claude/**",
    "dist",
    "node_modules",
    "apps/marketing/**",
    "examples/**",
    "tests/fixtures/**",
    "packages/basalt-ui/test/fixtures/**",
    "**/*.module.css.d.ts"
  ],
  "overrides": [
    {
      "files": ["packages/basalt-ui/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "framer-motion",
                "message": "Import from 'motion/react', not the raw framer-motion package."
              },
              {
                "name": "@tanstack/charts/react",
                "message": "Only src/charts/host.tsx imports the engine host; render charts through it."
              }
            ],
            "patterns": [
              {
                "group": ["@visx/*"],
                "message": "@visx/* is not part of basalt-ui; draw charts through the engine subpaths."
              },
              {
                "group": ["@tanstack/charts/react/*"],
                "message": "Only src/charts/host.tsx imports the engine host; render charts through it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/basalt-ui/src/charts/**"],
      "rules": {
        "no-underscore-dangle": "off"
      }
    },
    {
      "files": [
        "packages/basalt-ui/src/cli/**",
        "packages/basalt-ui/bin/**",
        "packages/basalt-ui/scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/basalt-ui/src/charts/host.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "framer-motion",
                "message": "Import from 'motion/react', not the raw framer-motion package."
              }
            ],
            "patterns": [
              {
                "group": ["@visx/*"],
                "message": "@visx/* is not part of basalt-ui; draw charts through the engine subpaths."
              }
            ]
          }
        ]
      }
    }
  ]
}
