    "basalt/viewport-keyed": "error",
    "basalt/dark-fork": "error",
    "basalt/fixed-color": "error",
    "basalt/status-fill-as-text": "error",
    "basalt/raw-scroll": "error",
    "basalt/tw-off-law": "error",
    "basalt/app-spacing": "error",
    "basalt/motion-off-scale": "error",
    "basalt/logical-properties": "off",
    "basalt/import-boundary": "error",
    "basalt/primitive-bypass": "error",
    "basalt/color-literal": "error",
    "basalt/motion-literal": "error",
    "basalt/waiver-needs-reason": "error",
    "basalt/data-primitive": "error",
    "basalt/router-search": "error",
    "basalt/control-home": "error",
    "basalt/untrusted-markdown": "error",
    "basalt/page-root": "error",
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": [
          "shadow-2xs",
          "shadow-xs",
          "shadow-sm",
          "shadow-md",
          "shadow-lg",
          "shadow-xl",
          "shadow-2xl",
          "shadow-inner",
          "shadow-none",
          "*-accent",
          "*-selected",
          "*-scrim",
          "*-scrim-wash",
          "*-border"
        ],
        "message": "\"{{className}}\" is no color the theme declares. Token names are not classes: canvas is bg-background, raised is bg-popover, hover is bg-accent, hairline is border-border, ink is text-foreground, ink-muted is text-muted-foreground, ink-faint is text-faint. Otherwise app color comes from Status, Lozenge, DeltaBadge or a Num tone; the palette is derived, so no color is declared per app. A shadow or a type step is not a color: check its spelling."
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "grid-cols-[*]",
          "grid-rows-[*]",
          "*:grid-cols-[*]",
          "*:grid-rows-[*]"
        ],
        "message": "\"{{className}}\" hardcodes an off-token value. By kind: a color comes from Status, Lozenge, DeltaBadge or a Num tone; overflow is ui/scroll-area, or the page owns the scroll; space around an element is gap on the parent; a spacing value is a step of the spacing ladder (integers, halves below 4); a width belongs to the parent container, and one computed from data is BarList, ui/progress or ui/meter."
      }
    ],
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "sm:*",
          "*:sm:*",
          "max-sm:*",
          "*:max-sm:*",
          "min-sm:*",
          "*:min-sm:*",
          "md:*",
          "*:md:*",
          "max-md:*",
          "*:max-md:*",
          "min-md:*",
          "*:min-md:*",
          "lg:*",
          "*:lg:*",
          "max-lg:*",
          "*:max-lg:*",
          "min-lg:*",
          "*:min-lg:*",
          "xl:*",
          "*:xl:*",
          "max-xl:*",
          "*:max-xl:*",
          "min-xl:*",
          "*:min-xl:*",
          "2xl:*",
          "*:2xl:*",
          "max-2xl:*",
          "*:max-2xl:*",
          "min-2xl:*",
          "*:min-2xl:*",
          "min-[*]:*",
          "*:min-[*]:*",
          "max-[*]:*",
          "*:max-[*]:*"
        ],
        "message": "\"{{className}}\" is no class or variant this project's Tailwind knows. Token names are not classes: canvas is bg-background, raised is bg-popover, hover is bg-accent, hairline is border-border, ink is text-foreground, ink-muted is text-muted-foreground, ink-faint is text-faint. Nearest spelling: {{suggestions|none}}. A radius is rounded-ctrl or rounded-chip; a card surface is owned by Card and Inset; no class or variant is declared per app."
      }
    ],
    "shadcn/no-inline-styles": [
      "error",
      {
        "message": "An inline style sets a value outside the design system. A bar, column or mark sized from data is BarList from basalt-ui/cards, ui/progress, ui/meter or a chart kind; any other value is a class, or a theme token in CSS."
      }
    ],
    "shadcn/require-static-classes": [
      "error",
      {
        "componentImports": [
          "^basalt-ui/ui/"
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout"
        ],
        "message": {
          "spacing": "\"{{className}}\" is not allowed on <{{component}}>: it owns its spacing. Use its size prop if it has one, or gap-* on the parent for space around it."
        },
        "componentImports": [
          "^basalt-ui/ui/"
        ],
