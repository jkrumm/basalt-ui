---
import BasaltFonts from 'basalt-ui/astro/BasaltFonts.astro'
import SiteHead from 'basalt-ui/astro/SiteHead.astro'
import type { SiteHeadProps } from 'basalt-ui/astro'
import { SiteFooter, SiteHeader, ThemeSwitch } from 'basalt-ui/static'
import { FOOTER, LABELS, NAV, current } from '../lib/site'

interface Props extends Partial<SiteHeadProps> {}

const {
  title = 'Basalt UI: one look for dashboards, docs and content sites',
  description = 'A React framework on Base UI and Tailwind 4. Apps get the shell, charts and tables; content sites get static parts that ship no client JavaScript.',
  ...head
} = Astro.props

const links = current(NAV, Astro.url.pathname)
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...head} title={title} description={description} siteName="Basalt UI" locale="en_US">
      <meta name="darkreader-lock" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <script is:inline defer src="https://umami.jkrumm.com/p.js" data-website-id="d6758a6a-6006-4f77-a778-54b74c3ac53d"></script>
    </SiteHead>
    <BasaltFonts />
  </head>
  <body class="flex min-h-dvh flex-col bg-background text-foreground antialiased">
    <SiteHeader links={links} navLabel={LABELS.nav} menuLabel={LABELS.menu}>
      <a slot="brand" href="/" class="flex items-center gap-2">
        <span class="inline-block size-5 rounded-chip bg-brand-fill" aria-hidden="true"></span>
        Basalt UI
      </a>
      <Fragment slot="actions">
        <a href="https://github.com/jkrumm/basalt-ui" class="text-sm text-muted-foreground hover:text-foreground">GitHub</a>
        <ThemeSwitch label={LABELS.scheme} labels={LABELS.schemes} />
      </Fragment>
    </SiteHeader>
    <main class="flex-1"><slot /></main>
    <SiteFooter groups={FOOTER}>
      <Fragment slot="brand">
        <span class="font-head text-md font-semibold text-foreground">Basalt UI</span>
        <p>A React framework on Base UI and Tailwind 4 for dashboards, docs and content sites.</p>
      </Fragment>
      <span>© 2026 Johannes Krumm</span>
      <span>MIT licence</span>
    </SiteFooter>
  </body>
</html>
