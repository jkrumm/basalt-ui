---
import { SiteArticle, SiteCallout } from 'basalt-ui/static'
import Layout from '../layouts/Layout.astro'
import { DeploysChart, DeploysChartFallback } from '../islands/DeploysChart'
import { LABELS } from '../lib/site'

const toc = [
  { id: 'an-island', label: 'A chart is an island', level: 2 },
  { id: 'the-ladder', label: 'The hydration ladder', level: 2 },
]
---

<Layout title="Charts | Basalt UI" description="A basalt chart on a static page: one island, rendered on the client because a chart measures its box.">
  <SiteArticle title="Charts" description="The one island on this site. Every other part on it is static HTML." toc={toc} tocLabel={LABELS.toc}>
    <DeploysChart client:only="react">
      <DeploysChartFallback slot="fallback" />
    </DeploysChart>
    <h2 id="an-island">A chart is an island</h2>
    <p>
      A chart measures the box it draws in, so it renders in the browser: <code>client:only="react"</code>, with a fallback of the same height so nothing moves when it arrives. The React runtime ships once per page, however many islands share it.
    </p>
    <SiteCallout tone="info" title="One provider per island">
      A leaf like this chart needs no provider. An island that needs one wraps its own <code>BasaltProvider</code>; parts that must share state sit in the same island.
    </SiteCallout>
    <h2 id="the-ladder">The hydration ladder</h2>
    <ul>
      <li><code>client:visible</code> for a part below the fold.</li>
      <li><code>client:idle</code> for a part above the fold that the reader does not need at once.</li>
      <li><code>client:load</code> only for a part that must answer the first tap.</li>
      <li><code>client:only="react"</code> only for a part that measures its box, such as a chart.</li>
    </ul>
  </SiteArticle>
</Layout>
