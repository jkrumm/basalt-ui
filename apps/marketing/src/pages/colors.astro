---
import { SiteArticle } from 'basalt-ui/static'
import Layout from '../layouts/Layout.astro'
import { LABELS } from '../lib/site'

/** Every color role a page reads, grouped by job. The values are derived; this page only shows them. */
const groups = [
  { id: 'surfaces', title: 'Surfaces', roles: ['canvas', 'card', 'inset', 'raised', 'hover', 'selected'] },
  { id: 'ink', title: 'Ink', roles: ['ink', 'ink-muted', 'ink-faint', 'hairline', 'input'] },
  { id: 'accent', title: 'Accent', roles: ['brand', 'brand-fill', 'on-brand'] },
  { id: 'status', title: 'Status', roles: ['good', 'warn', 'bad', 'info'] },
  { id: 'series', title: 'Chart series', roles: ['chart-1', 'chart-2', 'chart-3', 'chart-4', 'chart-5'] },
  { id: 'sequential', title: 'Sequential ramp', roles: ['seq-1', 'seq-2', 'seq-3', 'seq-4', 'seq-5'] },
]
const toc = groups.map((g) => ({ id: g.id, label: g.title, level: 2 }))
---

<Layout title="Colors | Basalt UI" description="The basalt color roles in light and dark: surfaces, ink, accent, status and chart series, all derived from one accent seed.">
  <SiteArticle title="Colors" description="Every color is a role, derived from one accent seed. Switch the scheme in the header: each swatch follows." toc={toc} tocLabel={LABELS.toc}>
    <p>
      A page names a role, never a value: <code>var(--basalt-card)</code> in CSS, <code>bg-card</code> in a class. The palette is generated with contrast guaranteed, so a retune changes every role at once.
    </p>
    {groups.map((g) => (
      <>
        <h2 id={g.id}>{g.title}</h2>
        <ul class="grid list-none grid-cols-2 gap-3 ps-0 @regular:grid-cols-3">
          {g.roles.map((role) => (
            <li class="m-0 flex flex-col gap-2">
              <span class="block h-14 rounded-inset border border-border" style={`background-color: var(--basalt-${role})`}></span>
              <code class="self-start">--basalt-{role}</code>
            </li>
          ))}
        </ul>
      </>
    ))}
  </SiteArticle>
</Layout>
