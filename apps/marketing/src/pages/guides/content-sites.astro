---
import { SiteArticle, SitePager, siteMdxComponents } from 'basalt-ui/static'
import Layout from '../../layouts/Layout.astro'
import { LABELS } from '../../lib/site'
import { Content, frontmatter, getHeadings } from '../../guides/content-sites.mdx'

const components = siteMdxComponents({ copyLabel: LABELS.copy, copiedLabel: LABELS.copied })
const entries = getHeadings().map((h) => ({ id: h.slug, label: h.text, level: h.depth }))
---

<Layout title={`${frontmatter.title} | Basalt UI`} description={frontmatter.description}>
  <SiteArticle title={frontmatter.title} description={frontmatter.description} toc={entries} tocLabel={LABELS.toc}>
    <Fragment slot="meta"><time datetime="2026-11-20">20 Nov 2026</time><span aria-hidden="true">·</span><span>4 min read</span></Fragment>
    <Content components={components} />
    <SitePager
      slot="footer"
      label={LABELS.pages}
      prevLabel={LABELS.previous}
      nextLabel={LABELS.next}
      prev={{ href: '/', label: 'Overview' }}
      next={{ href: '/docs/installation', label: 'Installation' }}
    />
  </SiteArticle>
</Layout>
