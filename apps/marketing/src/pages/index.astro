---
import { Code } from 'astro:components'
import {
  SiteBento,
  SiteCallout,
  SiteCallToAction,
  SiteCodeBlock,
  SiteComparison,
  SiteFeature,
  SiteHero,
  SiteQuestionList,
  ThemeSwitch,
} from 'basalt-ui/static'
import { FleetStrip, HeroConsole } from '../components/HeroConsole'
import Layout from '../layouts/Layout.astro'
import { BENTO, BLOCKS_SNIPPET, CALL_TO_ACTION, COMPARISON, HERO, QUESTIONS } from '../lib/landing'
import { LABELS } from '../lib/site'

const themes = { light: 'github-light-high-contrast', dark: 'github-dark' } as const
---

<Layout>
  <SiteHero eyebrow={HERO.eyebrow} title={HERO.title} description={HERO.description} actions={HERO.actions}>
    <SiteCodeBlock copyLabel={LABELS.copy} copiedLabel={LABELS.copied}>
      <Code code="bun add basalt-ui" lang="bash" themes={themes} defaultColor={false} />
    </SiteCodeBlock>
    <HeroConsole slot="media" />
  </SiteHero>

  <SiteBento title={BENTO.title} description={BENTO.description}>
    <SiteFeature title={BENTO.dashboards.title} description={BENTO.dashboards.description} span="wide">
      <FleetStrip />
    </SiteFeature>
    <SiteFeature title={BENTO.scheme.title} description={BENTO.scheme.description}>
      <div class="flex justify-center">
        <ThemeSwitch label={LABELS.scheme} labels={LABELS.schemes} />
      </div>
    </SiteFeature>
    <SiteFeature title={BENTO.code.title} description={BENTO.code.description} span="wide">
      <SiteCodeBlock copyLabel={LABELS.copy} copiedLabel={LABELS.copied}>
        <Code code={BLOCKS_SNIPPET} lang="astro" themes={themes} defaultColor={false} />
      </SiteCodeBlock>
    </SiteFeature>
    <SiteFeature title={BENTO.callout.title} description={BENTO.callout.description}>
      <SiteCallout tone="info" title={BENTO.calloutNote.title}>{BENTO.calloutNote.text}</SiteCallout>
    </SiteFeature>
  </SiteBento>

  <SiteComparison
    title={COMPARISON.title}
    description={COMPARISON.description}
    caption={COMPARISON.caption}
    rowHeader={COMPARISON.rowHeader}
    columns={COMPARISON.columns}
    rows={COMPARISON.rows}
    yesLabel={LABELS.yes}
    noLabel={LABELS.no}
  >
    <Fragment slot="footnote">
      Profiles of basalt-ui 3 as <code>basalt-ui init --help</code> and the basalt-app skill state them, checked
      <time datetime="2026-11-20">20 November 2026</time>.
    </Fragment>
  </SiteComparison>

  <SiteQuestionList title={QUESTIONS.title} description={QUESTIONS.description} questions={QUESTIONS.items} />

  <SiteCallToAction title={CALL_TO_ACTION.title} description={CALL_TO_ACTION.description} actions={CALL_TO_ACTION.actions} />
</Layout>
