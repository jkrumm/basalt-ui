---
import { SiteArticle } from 'basalt-ui/static'
import Layout from '../layouts/Layout.astro'
import { LABELS } from '../lib/site'

const steps = [1, 2, 3, 4, 6, 8, 12, 16]
const radii = ['chip', 'ctrl', 'inset', 'card']
const toc = [
  { id: 'ladder', label: 'The spacing ladder', level: 2 },
  { id: 'radii', label: 'Radii', level: 2 },
  { id: 'rhythm', label: 'Prose rhythm', level: 2 },
]
---

<Layout title="Spacing | Basalt UI" description="The basalt spacing ladder, radii and prose rhythm.">
  <SiteArticle title="Spacing" description="One ladder of four-pixel steps, four radii and three rhythm steps for long text." toc={toc} tocLabel={LABELS.toc}>
    <h2 id="ladder">The spacing ladder</h2>
    <p>Space siblings with <code>gap-*</code> on the parent. A step is an integer, or a half below four.</p>
    <ul class="flex list-none flex-col gap-2 ps-0">
      {steps.map((s) => (
        <li class="m-0 flex items-center gap-4">
          <code class="w-16 shrink-0">gap-{s}</code>
          <span class="block h-3 rounded-chip bg-brand-fill" style={`inline-size: calc(var(--spacing) * ${s})`}></span>
          <span class="font-mono text-xs text-muted-foreground">{s * 4}px</span>
        </li>
      ))}
    </ul>
    <h2 id="radii">Radii</h2>
    <p>A surface owns its radius. A chip is the smallest, a card the largest.</p>
    <ul class="grid list-none grid-cols-2 gap-3 ps-0 @regular:grid-cols-4">
      {radii.map((r) => (
        <li class="m-0 flex flex-col gap-2">
          <span class="block h-14 border border-border bg-card" style={`border-radius: var(--basalt-radius-${r})`}></span>
          <code class="self-start">rounded-{r}</code>
        </li>
      ))}
    </ul>
    <h2 id="rhythm">Prose rhythm</h2>
    <p>Long text spaces its blocks with <code>--basalt-rhythm-1</code> to <code>--basalt-rhythm-3</code>: a list item, a paragraph, a section. This page is set in it.</p>
  </SiteArticle>
</Layout>
