---
import { SiteArticle } from 'basalt-ui/static'
import Layout from '../layouts/Layout.astro'
import { LABELS } from '../lib/site'

const ladder = [
  { rung: 'display', cls: 'text-display font-head font-semibold', sample: 'Dashboards in one look' },
  { rung: 'lg', cls: 'text-lg', sample: 'A standfirst under a page title' },
  { rung: 'base', cls: 'text-base', sample: 'Body text in an article, sixteen pixels on a 1.7 leading.' },
  { rung: 'md', cls: 'text-md', sample: 'A card title or a control label' },
  { rung: 'sm', cls: 'text-sm', sample: 'Table cells, captions and dense lists' },
  { rung: 'xs', cls: 'text-xs', sample: 'Meta lines and axis ticks' },
  { rung: 'micro', cls: 'text-micro', sample: 'EYEBROWS AND LEGENDS' },
]
const faces = [
  { token: 'font-sans', name: 'Nunito Sans', use: 'Body text and controls', className: 'font-sans' },
  { token: 'font-head', name: 'Hubot Sans', use: 'Headings and figures', className: 'font-head' },
  { token: 'font-mono', name: 'JetBrains Mono', use: 'Code, ids and timestamps', className: 'font-mono' },
]
const toc = [
  { id: 'faces', label: 'Faces', level: 2 },
  { id: 'ladder', label: 'The ladder', level: 2 },
]
---

<Layout title="Typography | Basalt UI" description="The basalt type faces and the seven-rung type ladder.">
  <SiteArticle title="Typography" description="Three variable faces and a seven-rung ladder. A page picks a rung, never a pixel size." toc={toc} tocLabel={LABELS.toc}>
    <h2 id="faces">Faces</h2>
    <table>
      <thead><tr><th>Token</th><th>Face</th><th>Used for</th></tr></thead>
      <tbody>
        {faces.map((f) => (
          <tr><td><code>--basalt-{f.token}</code></td><td class={f.className}>{f.name}</td><td>{f.use}</td></tr>
        ))}
      </tbody>
    </table>
    <h2 id="ladder">The ladder</h2>
    <p>Each rung pairs a size with its line height: <code>text-sm</code> sets both.</p>
    <dl class="flex flex-col gap-4">
      {ladder.map((r) => (
        <div class="flex flex-col gap-1 border-b border-border pb-4">
          <dt class="m-0 font-mono text-xs text-muted-foreground">text-{r.rung}</dt>
          <dd class={`m-0 text-foreground ${r.cls}`}>{r.sample}</dd>
        </div>
      ))}
    </dl>
  </SiteArticle>
</Layout>
