---
// The guide recipe: one collection, one route. A guide is one MDX file with a title, a description, a
// date and an order; the sidebar, the table of contents, the reading time and the pager come from the collection.
import { getCollection, render } from 'astro:content'
import { SiteArticle, SiteNav, SitePager, siteMdxComponents } from 'basalt-ui/static'
import Layout from '../../layouts/Layout.astro'
import { LABELS, day, readingMinutes } from '../../lib/site'

export async function getStaticPaths() {
  const guides = (await getCollection('guides')).toSorted((a, b) => a.data.order - b.data.order)
  return guides.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, guides, prev: guides[i - 1], next: guides[i + 1] },
  }))
}

const { entry, guides, prev, next } = Astro.props
const { Content, headings } = await render(entry)
const link = (g: (typeof guides)[number]) => ({ href: `/guides/${g.id}/`, label: g.data.title })
const components = siteMdxComponents({ copyLabel: LABELS.copy, copiedLabel: LABELS.copied })
const toc = headings.map((h) => ({ id: h.slug, label: h.text, level: h.depth }))
const sidebar = [
  { title: LABELS.guides, links: guides.map((g) => ({ ...link(g), current: g.id === entry.id })) },
]
---

<Layout title={`${entry.data.title} | Guides`} description={entry.data.description} type="article" published={entry.data.date}>
  <SiteArticle
    title={entry.data.title}
    description={entry.data.description}
    toc={toc}
    tocLabel={LABELS.toc}
    navLabel={LABELS.guides}
  >
    <SiteNav slot="nav" groups={sidebar} />
    <Fragment slot="meta">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{day(entry.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(entry.body)} min read</span>
    </Fragment>
    <Content components={components} />
    <SitePager
      slot="footer"
      label={LABELS.pages}
      prevLabel={LABELS.previous}
      nextLabel={LABELS.next}
      prev={prev && link(prev)}
      next={next && link(next)}
    />
  </SiteArticle>
</Layout>
