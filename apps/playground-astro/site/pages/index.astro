---
import { SitePostList } from 'basalt-ui/static'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Basalt site pages" description="A guide, an article, a post list and a changelog on basalt-ui's static parts.">
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-6 font-head text-display font-semibold">Site pages</h1>
    <SitePostList
      label="Page types"
      posts={[
        { href: '/guides/setup/', title: 'Guide', description: 'An ordered series in a collection, with a sidebar and a pager.' },
        { href: '/posts/', title: 'Post list and article', description: 'Posts sorted by date, each with its head and structured data.' },
        { href: '/changelog/', title: 'Changelog', description: 'Releases with their dates and grouped changes.' },
      ]}
    />
  </div>
</Layout>
