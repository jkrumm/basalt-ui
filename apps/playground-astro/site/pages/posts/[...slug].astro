---
// The article recipe: one post of a collection in `SiteArticle`, with the article head (canonical, Open
// Graph, JSON-LD) from `SiteHead`. Fenced code is Astro's Shiki, colored by the scheme through `basaltShiki`.
import { getCollection, render } from 'astro:content'
import { SiteArticle, SitePager, siteMdxComponents } from 'basalt-ui/static'
import Layout from '../../layouts/Layout.astro'
import { LABELS, day, readingMinutes } from '../../lib/site'

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }))
}

const { entry, newer, older } = Astro.props
const { Content, headings } = await render(entry)
const link = (p: NonNullable<typeof newer>) => ({ href: `/posts/${p.id}/`, label: p.data.title })
const components = siteMdxComponents({ copyLabel: LABELS.copy, copiedLabel: LABELS.copied })
const toc = headings.map((h) => ({ id: h.slug, label: h.text, level: h.depth }))
---

<Layout
  title={`${entry.data.title} | Posts`}
  description={entry.data.description}
  type="article"
  published={entry.data.date}
  modified={entry.data.updated}
  authors={[entry.data.author]}
  tags={entry.data.tags}
>
  <SiteArticle title={entry.data.title} description={entry.data.description} toc={toc} tocLabel={LABELS.toc}>
    <Fragment slot="meta">
      <span>{entry.data.author}</span>
      <span aria-hidden="true">·</span>
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{day(entry.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(entry.body)} min read</span>
    </Fragment>
    <Content components={components} />
    <SitePager
      slot="footer"
      label={LABELS.pages}
      prevLabel={LABELS.previous}
      nextLabel={LABELS.next}
      prev={older && link(older)}
      next={newer && link(newer)}
    />
  </SiteArticle>
</Layout>
