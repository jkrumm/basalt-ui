---
// The post list recipe: the collection sorted newest first, one `SitePostList`.
import { getCollection } from 'astro:content'
import { SitePostList } from 'basalt-ui/static'
import Layout from '../../layouts/Layout.astro'
import { LABELS, readingMinutes } from '../../lib/site'

const posts = (await getCollection('posts')).toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Layout title="Posts" description="Notes on building content sites with basalt-ui.">
  <div class="mx-auto max-w-3xl px-4 py-10 @regular:px-6">
    <h1 class="mb-8 font-head text-display font-semibold">Posts</h1>
    <SitePostList
      label={LABELS.posts}
      posts={posts.map((p) => ({
        href: `/posts/${p.id}/`,
        title: p.data.title,
        description: p.data.description,
        date: p.data.date,
        meta: `${readingMinutes(p.body)} min read`,
        tags: p.data.tags,
      }))}
    />
  </div>
</Layout>
