{
  "name": "basalt-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev:playground": "bun --filter @basalt-ui/playground dev",
    "dev:marketing": "bun --filter marketing dev",
    "dev": "bun run --parallel --filter @basalt-ui/playground --filter marketing dev",
    "fmt": "oxfmt --ignore-path=.gitignore --ignore-path=.oxfmtignore packages apps/playground apps/playground-astro *.json *.md",
    "fmt:check": "oxfmt --check --ignore-path=.gitignore --ignore-path=.oxfmtignore packages apps/playground apps/playground-astro *.json *.md",
    "format": "bun run fmt",
    "lint": "oxlint --ignore-pattern 'apps/playground/**' --ignore-pattern 'packages/basalt-ui/blocks/**' && bun run lint:playground",
    "lint:playground": "cd apps/playground && oxlint --deny-warnings --report-unused-disable-directives && cd ../.. && oxlint -c apps/playground/.oxlintrc.json --deny-warnings --report-unused-disable-directives packages/basalt-ui/blocks && cd apps/playground && bun run lint",
    "typecheck": "bun --filter basalt-ui typecheck && bun --filter @basalt-ui/playground typecheck && bun --filter marketing typecheck && bun --filter @basalt-ui/playground-astro typecheck && cd packages/basalt-ui && ./node_modules/.bin/tsc -p ../../scripts/evidence",
    "test": "bun test",
    "test:layout": "bun --config=./packages/basalt-ui/tests/layout/bunfig.toml test --timeout 60000 .layout.test.ts",
    "test:layout:harness": "bun --config=./packages/basalt-ui/tests/layout/bunfig.toml test --timeout 60000 packages/basalt-ui/tests/layout/harness",
    "pre:static": "bun run fmt:check && bun run lint && bun run typecheck && bun run check-budgets && bun run check-literals && bun run check-recipes-lint && bun run check-readme-types && bun run check-playground-lint",
    "pre": "bun run pre:static && make --no-print-directory test",
    "prepare": "lefthook install && bun scripts/merge-json.ts --install",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "evidence": "bun scripts/evidence/index.ts",
    "check-budgets": "cd packages/basalt-ui && bun scripts/check-budgets.ts",
    "check-literals": "bun packages/basalt-ui/scripts/check-literals.ts",
    "check-recipes-lint": "bun packages/basalt-ui/scripts/check-recipes-lint.ts",
    "check-readme-types": "bun packages/basalt-ui/scripts/check-readme-types.ts",
    "check-playground-lint": "bun packages/basalt-ui/scripts/check-playground-lint.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/cli": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "^30.0.0",
    "axe-core": "4.14.0",
    "chrome-launcher": "^1.2.3",
    "happy-dom": "21.0.4",
    "jsdom": "^31",
    "lefthook": "^2.2.2",
    "lighthouse": "^13.6.0",
    "lucide-react": "1.74.0",
    "oxfmt": "^0.78.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "^25.0.9",
    "ts-morph": "28.0.0"
  },
  "overrides": {
    "@emnapi/runtime": "1.11.3",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "lodash-es": "4.18.1",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "pacote": "21.5.1",
    "rolldown": "1.2.13",
    "seroval": "1.6.11",
    "seroval-plugins": "1.6.7",
    "tar": "7.5.23",
    "vite": "8.3.4",
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.4.3"
}
