{
  "name": "basalt-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev:playground": "bun --filter @basalt-ui/playground dev",
    "dev:marketing": "bun --filter marketing dev",
    "dev": "bun run --parallel --filter @basalt-ui/playground --filter marketing dev",
    "fmt": "oxfmt --ignore-path=.gitignore --ignore-path=.oxfmtignore packages apps/playground *.json *.md",
    "fmt:check": "oxfmt --check --ignore-path=.gitignore --ignore-path=.oxfmtignore packages apps/playground *.json *.md",
    "format": "bun run fmt",
    "lint": "oxlint",
    "typecheck": "bun --filter basalt-ui --filter @basalt-ui/playground typecheck",
    "test": "bun test",
    "test:layout": "bun --config=./packages/basalt-ui/tests/layout/bunfig.toml test --timeout 60000 packages/basalt-ui/tests/layout",
    "check-theme": "cd packages/basalt-ui && bun bin/basalt-ui.mjs check-theme",
    "pre": "bun run fmt:check && bun run lint && bun run typecheck && bun run check-theme && bun run check-budgets && bun test",
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "check-budgets": "cd packages/basalt-ui && bun scripts/check-budgets.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "happy-dom": "20.14.5",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2"
  }
}
