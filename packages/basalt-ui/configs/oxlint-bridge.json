{
  "plugins": ["react", "typescript", "jsx-a11y"],
  "jsPlugins": ["basalt-ui/lint", "@shadcn/lint"],
  "settings": {
    "shadcn": {
      "themeImports": ["^basalt-ui/"]
    },
    "jsx-a11y": {
      "components": {
        "Accordion": "div",
        "AccordionContent": "div",
        "AccordionItem": "div",
        "AccordionTrigger": "div",
        "Alert": "div",
        "AlertDialogContent": "div",
        "AlertDialogTrigger": "div",
        "Autocomplete": "div",
        "AutocompleteContent": "div",
        "AutocompleteInput": "div",
        "AutocompleteItem": "div",
        "Button": "button",
        "Card": "div",
        "CardBand": "div",
        "CardInfo": "div",
        "CardPhase": "div",
        "Checkbox": "div",
        "CheckboxGroup": "div",
        "Collapsible": "div",
        "CollapsibleContent": "div",
        "CollapsibleTrigger": "div",
        "Combobox": "div",
        "ComboboxChip": "div",
        "ComboboxChips": "div",
        "ComboboxContent": "div",
        "ComboboxInput": "div",
        "ComboboxItem": "div",
        "CountBadge": "div",
        "DatePicker": "div",
        "DateRangePicker": "div",
        "DeltaBadge": "div",
        "DialogClose": "div",
        "DialogContent": "div",
        "DialogDescription": "div",
        "DialogTitle": "div",
        "DialogTrigger": "div",
        "Field": "div",
        "FieldDescription": "div",
        "FieldError": "div",
        "FieldLabel": "label",
        "Fieldset": "fieldset",
        "FieldsetLegend": "legend",
        "Form": "form",
        "IconTile": "div",
        "Input": "input",
        "Inset": "div",
        "Kbd": "kbd",
        "Lozenge": "div",
        "MenuCheckboxItem": "div",
        "MenuContent": "div",
        "MenuGroup": "div",
        "MenuItem": "div",
        "MenuRadioGroup": "div",
        "MenuRadioItem": "div",
        "MenuSeparator": "div",
        "MenuSub": "div",
        "MenuTrigger": "div",
        "Meter": "div",
        "NativeSelect": "select",
        "Num": "div",
        "NumberField": "input",
        "PopoverContent": "div",
        "PopoverTrigger": "div",
        "Pressable": "button",
        "Progress": "div",
        "Radio": "div",
        "RadioGroup": "div",
        "Ring": "div",
        "ScrollArea": "div",
        "Segmented": "div",
        "SegmentedItem": "div",
        "Select": "div",
        "SelectContent": "div",
        "SelectGroup": "div",
        "SelectItem": "div",
        "SelectTrigger": "div",
        "SelectValue": "div",
        "Separator": "div",
        "SheetClose": "div",
        "SheetContent": "div",
        "SheetTitle": "div",
        "SheetTrigger": "div",
        "Skeleton": "div",
        "Slider": "div",
        "Spinner": "div",
        "Status": "div",
        "Swatch": "div",
        "Switch": "div",
        "Table": "table",
        "TableBody": "tbody",
        "TableCaption": "caption",
        "TableCell": "td",
        "TableHead": "th",
        "TableHeader": "thead",
        "TableRow": "tr",
        "Tabs": "div",
        "TabsContent": "div",
        "TabsList": "div",
        "TabsTrigger": "div",
        "Textarea": "textarea",
        "Toast": "div",
        "ToastClose": "div",
        "ToastDescription": "div",
        "ToastTitle": "div",
        "ToastViewport": "div",
        "Toolbar": "div",
        "ToolbarButton": "div",
        "ToolbarGroup": "div",
        "ToolbarSeparator": "div",
        "Tooltip": "div",
        "VirtualList": "div"
      }
    },
    "basalt": {
      "pins": {
        "oxlint": "1.93.0",
        "@shadcn/lint": "0.2.5"
      }
    }
  },
  "rules": {
    "basalt/viewport-keyed": "error",
    "basalt/dark-fork": "error",
    "basalt/fixed-colour": "error",
    "basalt/status-fill-as-text": "error",
    "basalt/raw-scroll": "off",
    "basalt/tw-off-law": [
      "error",
      {
        "profile": "bridge"
      }
    ],
    "basalt/app-spacing": "off",
    "basalt/import-boundary": "off",
    "basalt/primitive-bypass": "off",
    "basalt/colour-literal": "error",
    "basalt/waiver-needs-reason": "error",
    "basalt/data-primitive": "off",
    "basalt/router-search": "off",
    "basalt/control-home": "off",
    "basalt/untrusted-markdown": "off",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "componentImports": ["(?:^|/)components/ui(?:/|$)"],
        "contracts": []
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/components/ui/**"],
      "rules": {
        "basalt/viewport-keyed": "off",
        "basalt/dark-fork": "off",
        "basalt/fixed-colour": "off",
        "basalt/status-fill-as-text": "off",
        "basalt/raw-scroll": "off",
        "basalt/tw-off-law": "off",
        "basalt/app-spacing": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-restyle": "off"
      }
    }
  ]
}
