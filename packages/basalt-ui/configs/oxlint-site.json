{
  "plugins": ["react", "typescript", "jsx-a11y"],
  "jsPlugins": ["basalt-ui/lint", "@shadcn/lint"],
  "settings": {
    "shadcn": {
      "themeImports": ["^basalt-ui/"]
    },
    "jsx-a11y": {
      "components": {
        "Accordion": "div",
        "AccordionContent": "div",
        "AccordionItem": "div",
        "AccordionTrigger": "div",
        "Alert": "div",
        "AlertDialogContent": "div",
        "AlertDialogTrigger": "div",
        "Autocomplete": "div",
        "AutocompleteContent": "div",
        "AutocompleteInput": "div",
        "AutocompleteItem": "div",
        "Avatar": "div",
        "AvatarStack": "div",
        "Button": "button",
        "ButtonGroup": "div",
        "Card": "div",
        "CardBand": "div",
        "CardInfo": "div",
        "CardPhase": "div",
        "Checkbox": "div",
        "CheckboxGroup": "div",
        "CheckboxMatrix": "div",
        "ChoiceCard": "div",
        "Collapsible": "div",
        "CollapsibleContent": "div",
        "CollapsibleTrigger": "div",
        "Combobox": "div",
        "ComboboxChip": "div",
        "ComboboxChips": "div",
        "ComboboxContent": "div",
        "ComboboxInput": "div",
        "ComboboxItem": "div",
        "ControlGroup": "div",
        "CopyButton": "button",
        "CountBadge": "div",
        "DatePicker": "div",
        "DateRangePicker": "div",
        "DeltaBadge": "div",
        "DialogClose": "div",
        "DialogContent": "div",
        "DialogDescription": "div",
        "DialogTitle": "div",
        "DialogTrigger": "div",
        "EntityChip": "div",
        "EntityTitle": "div",
        "Field": "div",
        "FieldDescription": "div",
        "FieldError": "div",
        "FieldLabel": "label",
        "Fieldset": "fieldset",
        "FieldsetLegend": "legend",
        "FileUpload": "div",
        "Form": "form",
        "IconTile": "div",
        "InfoHint": "div",
        "Input": "input",
        "InputAddon": "div",
        "InputGroup": "div",
        "Inset": "div",
        "Kbd": "kbd",
        "Lozenge": "div",
        "MenuCheckboxItem": "div",
        "MenuContent": "div",
        "MenuGroup": "div",
        "MenuItem": "div",
        "MenuRadioGroup": "div",
        "MenuRadioItem": "div",
        "MenuSeparator": "div",
        "MenuSub": "div",
        "MenuTrigger": "div",
        "Meter": "div",
        "NativeSelect": "select",
        "Num": "div",
        "NumberField": "input",
        "OneTimeCode": "div",
        "PasswordInput": "input",
        "PopoverContent": "div",
        "PopoverTrigger": "div",
        "Pressable": "button",
        "PreviewCardContent": "div",
        "PreviewCardTrigger": "div",
        "Progress": "div",
        "QuickPicks": "div",
        "Radio": "div",
        "RadioGroup": "div",
        "ResizableHandle": "div",
        "ResizablePanel": "div",
        "ResizablePanelGroup": "div",
        "Ring": "div",
        "ScrollArea": "div",
        "Segmented": "div",
        "SegmentedItem": "div",
        "Select": "div",
        "SelectContent": "div",
        "SelectGroup": "div",
        "SelectItem": "div",
        "SelectTrigger": "div",
        "SelectValue": "div",
        "Separator": "div",
        "SheetClose": "div",
        "SheetContent": "div",
        "SheetTitle": "div",
        "SheetTrigger": "div",
        "Skeleton": "div",
        "Slider": "div",
        "SortableList": "div",
        "Spinner": "div",
        "Status": "div",
        "Swatch": "div",
        "SwatchPicker": "div",
        "Switch": "div",
        "Table": "table",
        "TableBody": "tbody",
        "TableCaption": "caption",
        "TableCell": "td",
        "TableHead": "th",
        "TableHeader": "thead",
        "TableRow": "tr",
        "Tabs": "div",
        "TabsContent": "div",
        "TabsList": "div",
        "TabsTrigger": "div",
        "TabsTriggerCount": "div",
        "TabsTriggerDot": "div",
        "TagInput": "div",
        "Textarea": "textarea",
        "Toast": "div",
        "ToastClose": "div",
        "ToastDescription": "div",
        "ToastTitle": "div",
        "ToastViewport": "div",
        "Toolbar": "div",
        "ToolbarButton": "div",
        "ToolbarGroup": "div",
        "ToolbarSeparator": "div",
        "Tooltip": "div",
        "VirtualList": "div"
      }
    },
    "basalt": {
      "pins": {
        "oxlint": "1.93.0",
        "@shadcn/lint": "0.2.5"
      }
    }
  },
  "rules": {
    "basalt/viewport-keyed": "error",
    "basalt/dark-fork": "error",
    "basalt/fixed-colour": "error",
    "basalt/status-fill-as-text": "error",
    "basalt/raw-scroll": "off",
    "basalt/tw-off-law": [
      "error",
      {
        "profile": "bridge"
      }
    ],
    "basalt/app-spacing": "off",
    "basalt/motion-off-scale": "error",
    "basalt/logical-properties": "error",
    "basalt/import-boundary": "off",
    "basalt/primitive-bypass": "off",
    "basalt/colour-literal": "error",
    "basalt/motion-literal": "error",
    "basalt/waiver-needs-reason": "error",
    "basalt/data-primitive": "off",
    "basalt/router-search": "off",
    "basalt/control-home": "off",
    "basalt/untrusted-markdown": "off",
    "basalt/page-root": "off",
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": [
          "shadow-2xs",
          "shadow-xs",
          "shadow-sm",
          "shadow-md",
          "shadow-lg",
          "shadow-xl",
          "shadow-2xl",
          "shadow-inner",
          "shadow-none",
          "*-accent",
          "*-selected",
          "*-scrim",
          "*-scrim-wash",
          "*-border"
        ],
        "message": "\"{{className}}\" is a raw colour. Use one theme class with no dark: variant (tokens switch per scheme): ink is text-foreground or text-muted-foreground, status text text-good or text-brand, a surface bg-background, bg-card or bg-popover, a line border-border. Token names are not classes: canvas is bg-background, raised is bg-popover, hover is bg-accent, hairline is border-border, ink is text-foreground, ink-muted is text-muted-foreground, ink-faint is text-faint. No colour is added per app."
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": ["grid-cols-[*]", "grid-rows-[*]", "*:grid-cols-[*]", "*:grid-rows-[*]"]
      }
    ],
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "sm:*",
          "*:sm:*",
          "max-sm:*",
          "*:max-sm:*",
          "min-sm:*",
          "*:min-sm:*",
          "md:*",
          "*:md:*",
          "max-md:*",
          "*:max-md:*",
          "min-md:*",
          "*:min-md:*",
          "lg:*",
          "*:lg:*",
          "max-lg:*",
          "*:max-lg:*",
          "min-lg:*",
          "*:min-lg:*",
          "xl:*",
          "*:xl:*",
          "max-xl:*",
          "*:max-xl:*",
          "min-xl:*",
          "*:min-xl:*",
          "2xl:*",
          "*:2xl:*",
          "max-2xl:*",
          "*:max-2xl:*",
          "min-2xl:*",
          "*:min-2xl:*",
          "min-[*]:*",
          "*:min-[*]:*",
          "max-[*]:*",
          "*:max-[*]:*"
        ]
      }
    ],
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": [
      "error",
      {
        "componentImports": ["^basalt-ui/(?:ui|static)/"]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "componentImports": ["^basalt-ui/(?:ui|static)/"],
        "contracts": []
      }
    ],
    "no-use-before-define": "off"
  },
  "overrides": [
    {
      "files": ["**/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["**/components/ui/**"],
      "rules": {
        "basalt/viewport-keyed": "off",
        "basalt/dark-fork": "off",
        "basalt/fixed-colour": "off",
        "basalt/status-fill-as-text": "off",
        "basalt/raw-scroll": "off",
        "basalt/tw-off-law": "off",
        "basalt/app-spacing": "off",
        "basalt/motion-off-scale": "off",
        "basalt/logical-properties": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/no-unknown-classes": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-restyle": "off"
      }
    }
  ]
}
