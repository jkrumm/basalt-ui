{
  "extends": ["./oxlint-basalt.json"],
  "plugins": ["react", "typescript", "import", "unicorn", "jsx-a11y", "promise", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-var": "error",
    "eqeqeq": ["error", "smart"],
    "no-console": "warn",
    "no-shadow": "off",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__APP_VERSION__"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "antd",
                "message": "Use Mantine — antd is not part of the basalt-ui stack."
              },
              {
                "name": "framer-motion",
                "message": "Import from 'motion/react', not the raw framer-motion package."
              }
            ]
          }
        ]
      }
    }
  ]
}
