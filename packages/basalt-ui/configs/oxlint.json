{
  "plugins": ["react", "typescript", "import", "unicorn", "jsx-a11y", "promise", "oxc"],
  "jsPlugins": ["./oxlint-plugin.js"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-var": "error",
    "eqeqeq": ["error", "smart"],
    "no-console": "warn",
    "no-shadow": "off",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "warn",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__APP_VERSION__"]
      }
    ],
    "basalt/no-raw-font-size": "error",
    "basalt/raw-size-literal": "error",
    "basalt/card-inset": "error",
    "basalt/chart-in-raw-surface": "error",
    "basalt/hand-rolled-plot": "error",
    "basalt/chart-legend-literal": "error",
    "basalt/shadow-basalt-export": "warn",
    "basalt/hand-rolled-shell": "error",
    "basalt/raw-scroll-container": "error",
    "basalt/hand-rolled-filter": "error",
    "basalt/control-outside-home": "warn",
    "basalt/bound-control-outside-home": "warn",
    "basalt/control-size-literal": "error",
    "basalt/page-bar-budget": "error",
    "basalt/in-body-page-title": "error",
    "basalt/responsive-twin": "error",
    "basalt/search-literal-link": "error",
    "basalt/use-search-from-literal": "error",
    "basalt/provider-above-router": "warn",
    "basalt/duplicate-notifications-mount": "warn",
    "basalt/query-dual-import": "warn",
    "basalt/query-fn-unwrap": "warn",
    "basalt/deprecated-export": "warn",
    "basalt/visx-boundary": "error",
    "basalt/visx-tooltip": "error",
    "basalt/agent-resume-guard": "error",
    "basalt/agent-no-raw-usechat": "error",
    "basalt/ai-sdk-major": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "antd",
                "message": "Use Mantine — antd is not part of the basalt-ui stack."
              },
              {
                "name": "framer-motion",
                "message": "Import from 'motion/react', not the raw framer-motion package."
              }
            ]
          }
        ]
      }
    }
  ]
}
