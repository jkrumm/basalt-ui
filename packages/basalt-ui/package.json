{
  "name": "basalt-ui",
  "version": "2.1.0",
  "description": "Opinionated framework for Mantine-based React apps — theme, app shell, TanStack Charts, toolchain presets",
  "keywords": [
    "charts",
    "design-system",
    "mantine",
    "oxlint",
    "react",
    "tanstack-charts",
    "theme"
  ],
  "homepage": "https://github.com/jkrumm/basalt-ui/tree/master/packages/basalt-ui#readme",
  "bugs": {
    "url": "https://github.com/jkrumm/basalt-ui/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Johannes Krumm",
    "url": "https://jkrumm.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkrumm/basalt-ui.git",
    "directory": "packages/basalt-ui"
  },
  "bin": {
    "basalt-ui": "./bin/basalt-ui.mjs"
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "configs/",
    "agent/",
    "bin/",
    "llms.txt",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "MIGRATING.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js",
      "default": "./dist/controls/index.js"
    },
    "./controls-dates": {
      "types": "./dist/controls-dates/index.d.ts",
      "import": "./dist/controls-dates/index.js",
      "default": "./dist/controls-dates/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js",
      "default": "./dist/forms/index.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "default": "./dist/state.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js",
      "default": "./dist/table/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js",
      "default": "./dist/format/index.js"
    },
    "./commands": {
      "types": "./dist/commands/index.d.ts",
      "import": "./dist/commands/index.js",
      "default": "./dist/commands/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js",
      "default": "./dist/agent/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "default": "./dist/content/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css",
    "./configs/*": "./configs/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap && bun scripts/gen-chart-css.ts --check && bun scripts/copy-assets.mjs && bun scripts/gen-tokens-css.mjs && bun scripts/fix-esm-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "check-budgets": "bun scripts/check-budgets.ts",
    "test": "cd ../.. && bun test packages/basalt-ui",
    "pack-test": "bash scripts/pack-test.sh",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@fontsource-variable/hubot-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@mantine/dates": "9.7.1",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-hotkeys": "0.13.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.4.2",
    "@types/d3-scale": "4.0.9",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ai": "^7.0.137",
    "beautiful-mermaid": "^1.1.3",
    "d3-scale": "4.0.2",
    "motion": "14.1.0",
    "publint": "0.3.24",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.4.0",
    "shiki": "^4.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@fontsource-variable/hubot-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@mantine/core": "^9.7.0",
    "@mantine/dates": "^9.7.0",
    "@mantine/form": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/modals": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@mantine/spotlight": "^9.7.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-hotkeys": "0.13.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": ">=3.14.0 <4",
    "ai": "^7.0.137",
    "beautiful-mermaid": "^1.1.0",
    "d3-scale": "4.0.2",
    "dayjs": "^1.11.0",
    "motion": "14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remend": "1.4.0",
    "shiki": "^4.5.0",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^7 || ^8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@mantine/dates": {
      "optional": true
    },
    "@mantine/form": {
      "optional": true
    },
    "@shikijs/langs": {
      "optional": true
    },
    "@shikijs/themes": {
      "optional": true
    },
    "@tanstack/charts": {
      "optional": true
    },
    "@tanstack/react-hotkeys": {
      "optional": true
    },
    "@tanstack/react-query-devtools": {
      "optional": true
    },
    "@tanstack/react-router-devtools": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "beautiful-mermaid": {
      "optional": true
    },
    "d3-scale": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "rehype-sanitize": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remend": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "use-stick-to-bottom": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-pwa": {
      "optional": true
    }
  },
  "basalt": {
    "roots": [
      "src"
    ],
    "exempt": [
      "src/tokens/palette.ts",
      "src/tokens/core.ts",
      "src/tokens/derive.ts",
      "src/tokens/hct.ts",
      "src/theme/index.ts",
      "src/guard/index.ts",
      "src/cli/index.ts"
    ],
    "rawRadius": true,
    "exemptRules": {
      "inline-spacing": [
        "charts"
      ],
      "inline-display": [
        "agent"
      ],
      "raw-html-layout": [
        "agent"
      ]
    }
  }
}
