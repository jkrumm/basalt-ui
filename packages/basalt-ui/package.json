  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationMap && bun scripts/gen-chart-css.ts --check && bun scripts/copy-assets.mjs && bun scripts/rewrite-ui-specifiers.mjs && bun scripts/fix-esm-extensions.mjs && bun scripts/gen-llms.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.nav-guard.json && tsc --noEmit -p tsconfig.rule-tags.json",
    "check-budgets": "bun scripts/check-budgets.ts",
    "test": "cd ../.. && bun test packages/basalt-ui",
    "pack-test": "bash scripts/pack-test.sh",
    "prepack": "bun run build",
    "clean": "rm -rf dist"
  },
