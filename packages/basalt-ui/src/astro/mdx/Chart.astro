---
// The `Chart` MDX tag: a chart island with its hydration directive chosen by `load`.
// `only` (default) renders on the client behind a fallback of the card's height, because the
// server picture of a chart still differs from the browser's; `visible` and `idle` server-render it.
// The island's module is a sibling file of the published dist, hence the `.js` specifier.
import { ChartIsland } from './chart-island.js'
import type { ChartIslandProps } from './chart-island.js'

interface Props extends ChartIslandProps {
  load?: 'only' | 'visible' | 'idle'
}
const { load = 'only', ...props } = Astro.props
---

{
  load === 'only' && (
    <ChartIsland {...props} client:only="react">
      <div slot="fallback" class="h-[25rem] rounded-card bg-card" />
    </ChartIsland>
  )
}
{load === 'visible' && <ChartIsland {...props} client:visible />}
{load === 'idle' && <ChartIsland {...props} client:idle />}
