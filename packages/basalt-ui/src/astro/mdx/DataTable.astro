---
// The `DataTable` MDX tag: static HTML by default, a sortable island with `interactive`.
// The island's module is a sibling file of the published dist, hence the `.js` specifiers.
// Only the three data props reach either branch, so both read the same words the same way.
import { SiteDataTable } from '../../static/data-table.js'
import type { SiteColumn, SiteRow } from '../../static/data-table.js'
import { TableIsland } from './table-island.js'

interface Props {
  label: string
  columns: SiteColumn[]
  rows: SiteRow[]
  interactive?: boolean
  load?: 'visible' | 'idle'
}
const { interactive = false, load = 'visible', label, columns, rows } = Astro.props
const data = { label, columns, rows }
---

{!interactive && <SiteDataTable {...data} />}
{interactive && load === 'visible' && <TableIsland {...data} client:visible />}
{interactive && load === 'idle' && <TableIsland {...data} client:idle />}
