{
  // linewatch's web app: bundler resolution, strict, no emit.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [],
    "lib": ["ES2023", "DOM"],
    /* app-local alias */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
