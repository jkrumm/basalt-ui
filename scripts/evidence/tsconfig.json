{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "typeRoots": ["../../packages/basalt-ui/node_modules/@types"],
    "types": ["bun"],
    "paths": {
      "basalt-ui": ["../../apps/playground/node_modules/basalt-ui/dist/index.d.ts"],
      "basalt-ui/charts": ["../../apps/playground/node_modules/basalt-ui/dist/charts/index.d.ts"],
      "basalt-ui/table": ["../../apps/playground/node_modules/basalt-ui/dist/table/index.d.ts"],
