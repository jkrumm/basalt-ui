        "id": "rq-onmutate-cache-write",
        "role": "copy",
        "all": [{ "ident": "^onMutate$" }, { "call": "(^|\\.)setQueryData$" }]
      },
      {
        "id": "named-optimistic",
        "role": "copy",
        "all": [{ "decl": "^(optimistic\\w*|\\w*Optimistic\\w*)$" }]
      }
    ]
  },
